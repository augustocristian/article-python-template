# Copy to .env (gitignored) and fill in only what you need to override — any
# variable left unset falls back to article/outputs/, which is fine for a
# quick local test run against the sample corpus.

# Where figures (figures/) and LaTeX tables (sheets/) get written.
# Point this at your actual paper repo (e.g. an Overleaf git bridge checkout)
# once you have one.
#ARTICLE_OUTPUT_BASE_DIR=C:\path\to\your-article-repo

# Where a companion replication-package repo's data/ subfolder lives, if you
# publish one (e.g. on Zenodo) alongside the paper.
#RP_OUTPUT_BASE_DIR=C:\path\to\your-replication-package-repo

# Local debug outputs (PNG figure previews, citations.txt). Defaults to
# article/outputs/.
#OUTPUT_BASE_DIR=C:\path\to\local\outputs

# Where corpus.csv (and any raw source data) is read from. Defaults to
# article/input/.
#INPUT_DIR=C:\path\to\your\input\data
